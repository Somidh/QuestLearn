# Which model the agents use. Only gemini is wired up so far.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash.
GEMINI_MODEL=

# Free key from tavily.com. Resource Scout searches the web with it.
TAVILY_API_KEY=

# Added by pnpm switch:key.
SWITCH_REGISTRATION_KEY=
SWITCH_API_URL=http://localhost:8000
